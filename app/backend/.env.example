# Dev DB (SQLite). For production, switch schema.prisma provider to "postgresql"
# and set DATABASE_URL to a Postgres connection string.
DATABASE_URL="file:./dev.db"
# Secret used to sign the session cookie. Set a strong value in production.
SESSION_SECRET="dev-insecure-change-me-please-32chars-min"
PORT=4000
# Comma-separated allowed CORS origins (frontend dev server)
CORS_ORIGIN="http://localhost:5173"
