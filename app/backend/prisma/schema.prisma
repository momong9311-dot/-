// Merci Momong — Education & Growth Platform
// Source of truth for the data model. See docs/DATA_MODEL.md.
//
// DB: SQLite for the dev/MVP (no Docker in this env). Postgres-ready:
//   to move to Postgres, change provider to "postgresql" and set DATABASE_URL.
// SQLite notes: no native enum / Json types, so enum-like values are String
//   (validated in app code) and JSON blobs are stored as String (text).
//
// INVARIANTS (see docs/EDUCATION_SYSTEM.md §10, DATA_MODEL.md §6):
//  - The 6 axes are separate tables: LearningProgress / Practice / CustomerCase
//    / Evaluation / Feedback / SkillProgress. Completion is NEVER growth.
//  - Levels, content, criteria are DATA, not hardcoded.
//  - Skill state is multi-dimensional (levels + counts + growth history),
//    never a single score.
//  - Promotion is decision-support only; never auto-decided.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization / People
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  key         String   @unique // designer | leader | educator | admin
  name        String
  permissions String   @default("[]") // JSON array of permission strings
  users       User[]
  createdAt   DateTime @default(now())
}

model Branch {
  id            String  @id @default(uuid())
  name          String
  region        String?
  isActive      Boolean @default(true)
  users         User[]
  customerCases CustomerCase[]
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  levelId      String? // current overall growth stage
  level        Level?    @relation("UserLevel", fields: [levelId], references: [id])
  isActive     Boolean   @default(true)
  isSeed       Boolean   @default(false) // separate seed vs real data
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // owned activity
  skillProgress      SkillProgress[]
  learningProgress   LearningProgress[]
  practices          Practice[]
  customerCases      CustomerCase[]
  evaluationsAbout   Evaluation[]       @relation("EvaluationSubject")
  evaluationsAuthored Evaluation[]      @relation("EvaluationAuthor")
  feedbackReceived   Feedback[]         @relation("FeedbackSubject")
  feedbackAuthored   Feedback[]         @relation("FeedbackAuthor")

  // Operations manual (운영 매뉴얼)
  manualsAuthored    Manual[]              @relation("ManualAuthor")
  manualReads        ManualReadReceipt[]   @relation("ManualReader")
}

// ---------------------------------------------------------------------------
// Growth axes (reference): Level & Skill — DATA, not hardcoded
// ---------------------------------------------------------------------------

model Level {
  id          String  @id @default(uuid())
  order       Int     @unique // 1..6
  code        String  @unique // FOUNDATION, PRACTICE, ...
  name        String
  description String?
  criteria    String? // JSON: tunable attainment criteria

  usersAtLevel        User[]          @relation("UserLevel")
  lessonsTargeting    Lesson[]        @relation("LessonTargetLevel")
  curriculaTargeting  Curriculum[]    @relation("CurriculumTargetLevel")
  skillProgressCurrent SkillProgress[] @relation("SkillProgressCurrentLevel")
  skillProgressTarget  SkillProgress[] @relation("SkillProgressTargetLevel")
  growthFrom          SkillGrowthEvent[] @relation("GrowthFromLevel")
  growthTo            SkillGrowthEvent[] @relation("GrowthToLevel")
  promotionFrom       PromotionCriteria[] @relation("PromotionFromLevel")
  promotionTo         PromotionCriteria[] @relation("PromotionToLevel")
}

model EducationArea {
  id     String  @id @default(uuid())
  name   String
  order  Int     @default(0)
  skills Skill[]
}

model Skill {
  id              String   @id @default(uuid())
  educationAreaId String
  educationArea   EducationArea @relation(fields: [educationAreaId], references: [id])
  name            String
  isCore          Boolean  @default(false) // e.g. Diagnosis->Design connection
  order           Int      @default(0)

  curricula     Curriculum[]
  skillProgress SkillProgress[]
  practices     Practice[]
  customerCases CustomerCase[]
  caseSkills    CustomerCaseSkill[]
  evaluations   Evaluation[]
  feedback      Feedback[]
  promotionReqs PromotionCriteria[]
}

// ---------------------------------------------------------------------------
// Content hierarchy: Curriculum -> Course -> Module -> Lesson -> Assignment
// All content is DATA (admin-editable). Never hardcoded.
// ---------------------------------------------------------------------------

model Curriculum {
  id            String   @id @default(uuid())
  title         String
  description   String?
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  isSeed        Boolean  @default(false)
  skillId       String?
  skill         Skill?   @relation(fields: [skillId], references: [id])
  targetLevelId String?
  targetLevel   Level?   @relation("CurriculumTargetLevel", fields: [targetLevelId], references: [id])
  courses       Course[]
  createdAt     DateTime @default(now())
}

model Course {
  id           String     @id @default(uuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id])
  title        String
  description  String?
  order        Int        @default(0)
  isActive     Boolean    @default(true)
  isSeed       Boolean    @default(false)
  modules      Module[]
}

model Module {
  id       String   @id @default(uuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id])
  title    String
  description String?
  order    Int      @default(0)
  isActive Boolean  @default(true)
  isSeed   Boolean  @default(false)
  lessons  Lesson[]
}

model Lesson {
  id               String   @id @default(uuid())
  moduleId         String
  module           Module   @relation(fields: [moduleId], references: [id])
  title            String
  content          String   @default("") // rich content stored in DB, not code
  order            Int      @default(0)
  isRequired       Boolean  @default(true)
  targetLevelId    String?
  targetLevel      Level?   @relation("LessonTargetLevel", fields: [targetLevelId], references: [id])
  estimatedMinutes Int?
  isActive         Boolean  @default(true)
  isSeed           Boolean  @default(false)

  assignments      Assignment[]
  learningProgress LearningProgress[]
  practices        Practice[]
}

model Assignment {
  id           String   @id @default(uuid())
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id])
  title        String
  instructions String   @default("")
  type         String   @default("task") // read | quiz | task
  order        Int      @default(0)
  practices    Practice[]
}

// ---------------------------------------------------------------------------
// Axis 1 — Learning (completion). NOT growth.
// ---------------------------------------------------------------------------

model LearningProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  status      String    @default("not_started") // not_started | in_progress | completed
  progressPct Int       @default(0) // 0..100
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
}

// ---------------------------------------------------------------------------
// Axis 2 — Practice
// ---------------------------------------------------------------------------

model Practice {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  lessonId       String?
  lesson         Lesson?   @relation(fields: [lessonId], references: [id])
  assignmentId   String?
  assignment     Assignment? @relation(fields: [assignmentId], references: [id])
  skillId        String?
  skill          Skill?    @relation(fields: [skillId], references: [id])
  customerCaseId String? // if applied to a real customer -> promotes to Application
  customerCase   CustomerCase? @relation(fields: [customerCaseId], references: [id])
  evidence       String    @default("") // what was done (submission / evidence)
  reflection     String    @default("") // designer's own reflection
  status         String    @default("submitted") // submitted | reviewed
  submittedAt    DateTime  @default(now())
  evaluations    Evaluation[]
}

// ---------------------------------------------------------------------------
// Axis 3 — Application (CustomerCase). Employee-only internal education record
// of how a designer applied learning to a REAL customer. NOT a customer CRM.
// Minimal PII: no name / phone / address / birthdate — ever.
// ---------------------------------------------------------------------------

model CustomerCase {
  id                String   @id @default(uuid())
  designerId        String
  designer          User     @relation(fields: [designerId], references: [id])
  branchId          String?
  branch            Branch?  @relation(fields: [branchId], references: [id])
  skillId           String? // primary related skill (drives application count)
  skill             Skill?   @relation(fields: [skillId], references: [id])
  status            String   @default("draft") // draft | applied | completed

  // The customer-facing intent (no identity, only need/desire/concern)
  customerNeed      String?
  desiredImage      String?
  currentConcern    String?

  // The education thinking-structure: observe -> diagnose -> problem ->
  // image direction -> design strategy -> procedure -> result
  observation       String?
  diagnosis         String?
  problemDefinition String?
  imageDirection    String?

  // Design Strategy — the CORE. Never just a procedure name. Structured so the
  // "diagnosis -> design" reasoning is captured, not a bare label.
  designGoal        String?
  dsLength          String?
  dsSilhouette      String?
  dsVolume          String?
  dsLine            String?
  dsWeight          String?
  dsTexture         String?
  dsCurl            String?
  dsParting         String?
  dsFringe          String?
  dsColor           String?
  dsReason          String? // WHY this strategy follows from the diagnosis

  procedure         String?
  result            String?
  beforeRef         String? // media reference only (URL/ref, access-controlled)
  afterRef          String?
  designerReflection String?

  isSeed            Boolean  @default(false)
  createdAt         DateTime @default(now())
  completedAt       DateTime?
  updatedAt         DateTime @updatedAt

  relatedSkills CustomerCaseSkill[]
  practices     Practice[]
  evaluations   Evaluation[]
  feedback      Feedback[]
}

// Additional skills a case exercised (many-to-many). The primary skillId above
// stays the main one; these broaden which skills get an application credit.
model CustomerCaseSkill {
  id             String       @id @default(uuid())
  customerCaseId String
  customerCase   CustomerCase @relation(fields: [customerCaseId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill        @relation(fields: [skillId], references: [id])

  @@unique([customerCaseId, skillId])
}

// ---------------------------------------------------------------------------
// Axis 4 — Evaluation. Evaluates behavior/competency, not the person.
// ---------------------------------------------------------------------------

model Evaluation {
  id             String    @id @default(uuid())
  subjectUserId  String
  subjectUser    User      @relation("EvaluationSubject", fields: [subjectUserId], references: [id])
  evaluatorId    String
  evaluator      User      @relation("EvaluationAuthor", fields: [evaluatorId], references: [id])
  skillId        String?
  skill          Skill?    @relation(fields: [skillId], references: [id])
  practiceId     String?
  practice       Practice? @relation(fields: [practiceId], references: [id])
  customerCaseId String?
  customerCase   CustomerCase? @relation(fields: [customerCaseId], references: [id])
  // Which competency dimension this evaluation is about. Design Connection is
  // the core dimension (docs/EDUCATION_SYSTEM.md §1).
  dimension      String? // observation | diagnosis | problem | design_connection | execution | communication
  criteria       String    @default("")
  observation    String    @default("")
  strength       String    @default("")
  gap            String    @default("")
  nextAction     String    @default("") // -> connects to Feedback
  score          Int? // optional; never the sole growth signal
  status         String    @default("completed") // pending | completed
  createdAt      DateTime  @default(now())

  feedback      Feedback[]
  growthEvents  SkillGrowthEvent[]
}

// ---------------------------------------------------------------------------
// Axis 5 — Feedback. Always connects to a Next Action.
// ---------------------------------------------------------------------------

model Feedback {
  id             String    @id @default(uuid())
  evaluationId   String?
  evaluation     Evaluation? @relation(fields: [evaluationId], references: [id])
  subjectUserId  String
  subjectUser    User      @relation("FeedbackSubject", fields: [subjectUserId], references: [id])
  authorId       String
  author         User      @relation("FeedbackAuthor", fields: [authorId], references: [id])
  skillId        String?
  skill          Skill?    @relation(fields: [skillId], references: [id])
  customerCaseId String? // feedback given directly on a customer case
  customerCase   CustomerCase? @relation(fields: [customerCaseId], references: [id])
  strength       String    @default("")
  gap            String    @default("")
  message        String    @default("")
  nextAction     String    @default("") // required in spirit
  dueDate        DateTime? // when the next action should be done by
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Axis 6 — Skill Growth. Rises ONLY as a result of the other axes.
// ---------------------------------------------------------------------------

model SkillProgress {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  skillId          String
  skill            Skill    @relation(fields: [skillId], references: [id])
  currentLevelId   String?
  currentLevel     Level?   @relation("SkillProgressCurrentLevel", fields: [currentLevelId], references: [id])
  targetLevelId    String?
  targetLevel      Level?   @relation("SkillProgressTargetLevel", fields: [targetLevelId], references: [id])
  practiceCount    Int      @default(0)
  applicationCount Int      @default(0)
  evaluationCount  Int      @default(0)
  feedbackCount    Int      @default(0)
  updatedAt        DateTime @updatedAt

  growthHistory SkillGrowthEvent[]

  @@unique([userId, skillId])
}

// growth_history: WHY the skill moved. There is no "rose from completion".
model SkillGrowthEvent {
  id              String   @id @default(uuid())
  skillProgressId String
  skillProgress   SkillProgress @relation(fields: [skillProgressId], references: [id])
  fromLevelId     String?
  fromLevel       Level?   @relation("GrowthFromLevel", fields: [fromLevelId], references: [id])
  toLevelId       String?
  toLevel         Level?   @relation("GrowthToLevel", fields: [toLevelId], references: [id])
  causeType       String // evaluation | feedback | application | practice
  causeId         String?
  evaluationId    String?
  evaluation      Evaluation? @relation(fields: [evaluationId], references: [id])
  note            String?
  createdAt       DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Promotion — decision SUPPORT only. Never auto-decides.
// ---------------------------------------------------------------------------

model PromotionCriteria {
  id                String  @id @default(uuid())
  fromLevelId       String
  fromLevel         Level   @relation("PromotionFromLevel", fields: [fromLevelId], references: [id])
  toLevelId         String
  toLevel           Level   @relation("PromotionToLevel", fields: [toLevelId], references: [id])
  skillId           String?
  skill             Skill?  @relation(fields: [skillId], references: [id])
  skillRequirements String  @default("{}") // JSON: e.g. {"minLevelOrder":3,"minApplication":2}
  notes             String?
}

// ---------------------------------------------------------------------------
// Operations Manual (운영 매뉴얼) — staff + franchise owners.
// All manual content is DATA (admin-editable), never hardcoded (CLAUDE.md §6).
// "필독(required)" manuals track a per-user read receipt for the current
// version, so managers can see who has / hasn't acknowledged.
// ---------------------------------------------------------------------------

model ManualCategory {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  isSeed    Boolean  @default(false)
  manuals   Manual[]
  createdAt DateTime @default(now())
}

model Manual {
  id          String   @id @default(uuid())
  categoryId  String
  category    ManualCategory @relation(fields: [categoryId], references: [id])
  title       String
  summary     String?               // one-line summary for the list
  content     String   @default("") // body (markdown/plain), stored in DB not code
  targetRoles String   @default("[]") // JSON array of role keys; [] = everyone
  isRequired  Boolean  @default(false) // 필독
  isPublished Boolean  @default(true)
  version     Int      @default(1)   // bumps when content changes → re-ack needed
  order       Int      @default(0)
  authorId    String?
  author      User?    @relation("ManualAuthor", fields: [authorId], references: [id])
  isSeed      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  readReceipts ManualReadReceipt[]
}

model ManualReadReceipt {
  id       String   @id @default(uuid())
  manualId String
  manual   Manual   @relation(fields: [manualId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("ManualReader", fields: [userId], references: [id])
  version  Int      @default(1) // which manual version was acknowledged
  readAt   DateTime @default(now())

  @@unique([manualId, userId])
}
